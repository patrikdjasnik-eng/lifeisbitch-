{
  "name": "life-is-bitch",
  "version": "0.1.6",
  "description": "Life Is Bitch: Betonové sny — offline game",
  "author": "Rabbit Hollow",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:start": "electron .",
    "desktop:smoke": "electron . --smoke",
    "desktop:build": "electron-builder --win --x64 --dir --publish never",
    "test": "node tests/gameplay.cjs && node tests/updater.cjs && node tests/character.cjs && node tests/prague-geo.cjs",
    "desktop:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "cz.rabbithollow.lifeisbitch",
    "productName": "Life Is Bitch",
    "directories": {
      "output": "windows-dist"
    },
    "files": [
      "desktop/**",
      "web/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "desktop/icon-beta.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "desktop/icon-beta.ico",
      "uninstallerIcon": "desktop/icon-beta.ico",
      "installerHeaderIcon": "desktop/icon-beta.ico",
      "runAfterFinish": true,
      "shortcutName": "Life Is Bitch",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Life-Is-Bitch-Setup-${version}.${ext}",
    "portable": {
      "artifactName": "Life-Is-Bitch-Portable-${version}.${ext}"
    }
  }
}
